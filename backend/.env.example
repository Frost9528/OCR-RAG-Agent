# ==========================================
# AgenticRAGOCR 环境变量模板
# 复制为 .env 并填写实际值
# ==========================================

# 阿里云百炼 API Key（必填）
# 获取地址: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# LLM 模型名称（默认 qwen-turbo，可选 qwen-plus / qwen-max）
QWEN_MODEL_NAME=qwen-turbo

# Embedding 模型
EMBEDDING_MODEL=text-embedding-v3

# OCR 模式: cloud（推荐，无需 GPU）或 local（需要 Linux + GPU）
OCR_MODE=cloud

# 飞桨云端 OCR（cloud 模式必填）
PADDLEOCR_API_TOKEN=your_paddleocr_token_here
PADDLEOCR_API_URL=https://t7leseh0b8e85b24.aistudio-app.com/layout-parsing

# PaddleOCR 本地模型路径（local 模式才需要填写）
PADDLEOCR_VL_MODEL_DIR=/path/to/PaddleOCR-VL-0.9B
LAYOUT_DETECTION_MODEL_DIR=/path/to/PP-DocLayoutV2

# 向量数据库路径
CHROMA_PERSIST_DIR=./data/chroma_db

# 文件上传路径
UPLOAD_DIR=./uploads

# 服务端口与基础 URL（SERVER_BASE_URL 用于生成资源链接，需与实际访问地址一致）
PORT=8100
SERVER_BASE_URL=http://localhost:8100

# RAG 检索参数（可选）
RETRIEVAL_TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50
